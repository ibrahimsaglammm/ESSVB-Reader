{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESSVB-Reader",
  "mainBinaryName": "essvb-reader",
  "version": "0.1.0",
  "identifier": "dev.essvb.reader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ESSVB-Reader v0.1.0",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'self' blob: data:; base-uri 'none'; form-action 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Güvenli, telemetrisiz, çevrimdışı öncelikli EPUB okuyucu",
    "longDescription": "ESSVB-Reader: Sıfır telemetri, sıkı EPUB sandbox koruması, raf/etiket sınıflandırma, not/vurgulama ve Türkçe sesli okuma sunan çapraz platform masaüstü EPUB okuyucu (v0.1.0 hazırlık sürümü).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "EPUB Book",
        "description": "EPUB E-Book Document",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      }
    ]
  }
}
